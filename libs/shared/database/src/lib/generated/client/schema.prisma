// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// MODÈLES PRINCIPAUX
// =============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  isVerified    Boolean   @default(false)
  isMainAccount Boolean   @default(true)

  // Relations
  sessions            Session[]
  subscriptions       Subscription[]
  ownedSharedAccounts SharedAccount[] @relation("OwnerAccounts")
  purchases           Purchase[]

  comments Comment[]
  adViews  AdView[] // Added opposite relation for AdView

  userVideoView UserVideoView[]

  seasonView SeasonView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailValidation EmailValidation[]

  activeStreams ActiveStream[]
}

model Admin {
  id          String    @id @default(uuid())
  email       String    @unique
  firstName   String
  lastName    String
  country     String
  city        String
  state       String
  phoneNumber String
  address     String
  avatarUrl   String?
  lastLoginAt DateTime?
  isVerified  Boolean   @default(false)
  role        AdminRole @default(ADMIN)
  // Relations
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailValidation EmailValidation[]
}

model EmailValidation {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Session {
  id           String             @id @default(uuid())
  user         User?              @relation(fields: [userId], references: [id])
  userId       String?
  admin        Admin?             @relation(fields: [adminId], references: [id])
  adminId      String?
  profile      SharedAccountUser? @relation(fields: [profileId], references: [id])
  profileId    String?
  refreshToken String             @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  sessionType  SessionType        @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, refreshToken])
  @@index([profileId])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

// Exemple de modèle Prisma pour la table ActiveStream

model ActiveStream {
  id String @id @default(uuid())

  // Clé vers le spectateur (le profil)
  profile   SharedAccountUser @relation(fields: [profileId], references: [id])
  profileId String            @unique // Un profil ne peut avoir qu'un seul stream actif

  // Clé vers le compte payant (pour la vérification de la limite)
  account   User   @relation(fields: [accountId], references: [id])
  accountId String

  // Détails de la ressource
  videoId String? // La vidéo regardée

  // Durée de vie du stream (Critique)
  startedAt DateTime @default(now())
  expiresAt DateTime // Doit être mis à jour périodiquement (ping)

  @@index([accountId]) // Index nécessaire pour compter rapidement les streams actifs par compte
}

// =============================================
// ABONNEMENTS ET COMPTES PARTAGÉS
// =============================================

model SubscriptionPlan {
  id                String         @id @default(uuid())
  name              String         @unique
  price             Float
  maxSharedAccounts Int            @default(0)
  videoQuality      VideoQuality
  subscriptions     Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VideoQuality {
  SD
  HD
  UHD
}

model Subscription {
  id            String           @id @default(uuid())
  user          User             @relation(fields: [userId], references: [id])
  userId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  planId        String
  startDate     DateTime
  endDate       DateTime
  renewalStatus RenewalStatus    @default(AUTO_RENEW)
  country       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, endDate])
}

enum RenewalStatus {
  AUTO_RENEW
  MANUAL
  CANCELLED
}

model SharedAccount {
  id          String              @id @default(uuid())
  owner       User                @relation("OwnerAccounts", fields: [ownerUserId], references: [id])
  ownerUserId String
  status      SharedAccountStatus @default(PENDING)
  profiles    SharedAccountUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SharedAccountStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model SharedAccountUser {
  id              String        @id @default(uuid())
  sharedAccount   SharedAccount @relation(fields: [sharedAccountId], references: [id])
  sharedAccountId String
  profileName     String
  iskidProfile    Boolean       @default(false)
  avatarUrl       String?
  pinCode         String

  // Relations

  adViews    AdView[]
  activities SharedProfileActivity[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activeStreams ActiveStream[]
  sessions      Session[]

  @@unique([sharedAccountId, profileName])
}

enum SessionType {
  USER
  PROFILE
}

// =============================================
// CONTENU (VIDÉOS, FILMS, SÉRIES)
// =============================================

model VideoMetadata {
  id                String        @id @default(uuid())
  title             String
  description       String
  releaseDate       DateTime      @map("theater_release")
  platformDate      DateTime      @map("platform_publish")
  ageRating         String
  productionHouse   String
  productionCountry String
  director          String
  format            VideoFormat?  @relation(fields: [formatId], references: [id])
  formatId          String?
  category          VideoCategory @relation(fields: [categoryId], references: [id])
  categoryId        String
  gender            VideoGenre    @relation(fields: [genderId], references: [id])
  genderId          String
  status            ContentStatus @default(DRAFT)

  // Relations
  movie Movie?

  series    Serie?
  actors    VideoActor[]
  subtitles Subtitle[]      @relation("VideoMetadataToSubtitle")
  languages VideoLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_metadata")
}

model MediaFile {
  id        String          @id @default(uuid())
  s3Key     String
  duration  Int? // valable uniquement si mediaType = VIDEO
  width     Int?
  height    Int?
  status    MediaFileStatus
  mediaType MediaType // VIDEO | IMAGE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MediaAttachment[]

  Subtitle Subtitle[]
}

model MediaAttachment {
  id          String              @id @default(uuid())
  mediaFileId String
  movieId     String?
  episodeId   String?
  adId        String?
  serieId     String?
  type        MediaAttachmentType

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])
  movie     Movie?    @relation(fields: [movieId], references: [id])
  episode   Episode?  @relation(fields: [episodeId], references: [id])
  serie     Serie?    @relation(fields: [serieId], references: [id])
  ad        Ad?       @relation(fields: [adId], references: [id])
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaFileStatus {
  PENDING // En attente de traitement
  UPLOADED // Uploadé mais pas encore traité
  PROCESSING // En cours de traitement
  PROCESSED // Traitement terminé avec succès
  FAILED // Échec du traitement
  CANCELLED // Traitement annulé
  QUEUED
}

enum MediaAttachmentType {
  // vidéos
  MAIN
  TRAILER
  BONUS
  MAKING_OF
  CLIP
  PREVIEW
  ADVERTISEMENT
  // images
  THUMBNAIL
  POSTER
  BANNER
}

model VideoGenre {
  id     String          @id @default(uuid())
  name   String          @unique
  videos VideoMetadata[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_genres")
}

model Actor {
  id         String       @id @default(uuid())
  name       String
  VideoActor VideoActor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_actors")
}

model VideoActor {
  video   VideoMetadata @relation(fields: [videoId], references: [id])
  videoId String
  actor   Actor         @relation(fields: [actorId], references: [id])
  actorId String
  role    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([videoId, actorId])
}

model VideoLanguage {
  id     String          @id @default(uuid())
  code   String          @unique
  name   String
  videos VideoMetadata[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_languages")
}

// Enums complémentaires
enum AgeRating {
  G
  PG
  PG_13
  R
  NC_17
}

model VideoFormat {
  id          String          @id @default(uuid())
  format      String          @unique
  description String?
  videos      VideoMetadata[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoCategory {
  id          String          @id @default(uuid())
  category    String          @unique
  description String?
  videos      VideoMetadata[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoFileStatus {
  PENDING // En attente de traitement
  UPLOADED // Uploadé mais pas encore traité
  PROCESSING // En cours de traitement
  PROCESSED // Traitement terminé avec succès
  FAILED // Échec du traitement
  CANCELLED // Traitement annulé
  QUEUED
}

// ===== AGGREGATE ROOT 1 =====
model Movie {
  id         String        @id @default(uuid())
  metadata   VideoMetadata @relation(fields: [metadataId], references: [id])
  metadataId String        @unique

  tags        MovieTag[]
  status      ContentStatus     @default(DRAFT)
  type        String            @default("location")
  seasonCount Int               @default(0)
  rentalPrice Float?            @default(0)
  attachment  MediaAttachment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  Comment     Comment[]
  Purchase    Purchase[]

  // Règles métier (ex: durée max)
  @@map("movies")
}

// ===== AGGREGATE ROOT 2 =====
model Serie {
  id          String        @id @default(uuid())
  metadata    VideoMetadata @relation(fields: [metadataId], references: [id])
  metadataId  String        @unique
  seasons     Season[]
  tags        SeriesTag[]
  status      String        @default("draft")
  type        String        @default("location")
  seasonCount Int           @default(0)
  rentalPrice Float?        @default(0)
  SerieView   SerieView[]

  // Opposite relation for MediaAttachment
  attachment MediaAttachment[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Purchase  Purchase[]

  @@map("series")
}

model Season {
  id         String       @id @default(uuid())
  serie      Serie        @relation(fields: [serieId], references: [id])
  serieId    String
  number     Int
  episodes   Episode[]
  SeasonView SeasonView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serieId, number])
}

model Episode {
  id             String   @id @default(uuid())
  season         Season   @relation(fields: [seasonId], references: [id])
  seasonId       String
  number         Int
  title          String?
  releaseDate    DateTime
  plateformeDAte DateTime
  director       String
  description    String?
  isSaFliixProd  Boolean

  attachment MediaAttachment[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  Comment    Comment[]

  @@unique([seasonId, number])
  @@map("episodes")
}

// ====================================
// Vues
// ====================================
// Table de base pour tous les types de vues

model UserVideoView {
  id        String    @id @default(uuid())
  userId    String
  profileId String?
  videoId   String
  progress  Int       @default(0) // en secondes
  completed Boolean   @default(false)
  country   String?
  device    String?
  rating    Float? // note ou appréciation de l’utilisateur
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("user_video_view")
}

model SeasonView {
  id       String   @id @default(uuid())
  seasonId String
  season   Season   @relation(fields: [seasonId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  episodesWatched Int? // nombre d’épisodes vus dans cette saison
  totalTimeSpent  Int? // secondes totales passées à regarder cette saison
  rating          Float? // note ou appréciation de l’utilisateur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, userId])
}

model SerieView {
  id       String   @id @default(uuid())
  seriesId String
  series   Serie    @relation(fields: [seriesId], references: [id])
  userId   String
  viewedAt DateTime @default(now())

  seasonsWatched  Int? // nombre de saisons suivies
  episodesWatched Int? // total épisodes vus dans la série
  totalTimeSpent  Int? // temps total passé sur la série
  rating          Float? // appréciation globale de la série

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, userId])
}

// =============================================
// ENRICHISSEMENT DU CONTENU
// =============================================

model Tag {
  id   String @id @default(uuid())
  name String @unique

  // Relations
  movieTags  MovieTag[]
  seriesTags SeriesTag[]
}

model MovieTag {
  movie   Movie  @relation(fields: [movieId], references: [id])
  movieId String
  tag     Tag    @relation(fields: [tagId], references: [id])
  tagId   String

  @@id([movieId, tagId])
}

model SeriesTag {
  series   Serie  @relation(fields: [seriesId], references: [id])
  seriesId String
  tag      Tag    @relation(fields: [tagId], references: [id])
  tagId    String

  @@id([seriesId, tagId])
}

model Subtitle {
  video       MediaFile @relation(fields: [videoId], references: [id])
  videoId     String
  language    String
  subtitleUrl String

  videoMetadata   VideoMetadata? @relation("VideoMetadataToSubtitle", fields: [videoMetadataId], references: [id])
  videoMetadataId String?

  @@id([videoId, language])
}

// =============================================
// INTERACTIONS UTILISATEURS
// =============================================

model Purchase {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  movieId String?
  serieId String?

  movie          Movie?    @relation(fields: [movieId], references: [id])
  serie          Serie?    @relation(fields: [serieId], references: [id])
  purchaseDate   DateTime  @default(now())
  expirationDate DateTime?
  country        String
}

model Comment {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  movieId    String?
  epiisodeId String?
  text       String
  createdAt  DateTime @default(now())

  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  parentCommentId String?
  replies         Comment[] @relation("CommentReplies")

  movie   Movie?   @relation(fields: [movieId], references: [id])
  episode Episode? @relation(fields: [epiisodeId], references: [id])
}

// =============================================
// PUBLICITÉS
// =============================================

model Ad {
  id         String            @id @default(uuid())
  title      String
  imageUrl   String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean           @default(true)
  attachment MediaAttachment[]
  // Relations
  views      AdView[]
}

model AdView {
  id        String             @id @default(uuid())
  ad        Ad                 @relation(fields: [adId], references: [id])
  adId      String
  user      User?              @relation(fields: [userId], references: [id])
  userId    String?
  profile   SharedAccountUser? @relation(fields: [profileId], references: [id])
  profileId String?
  viewed_at DateTime           @default(now())
  country   String?
}

// =============================================
// AUDIT ET ACTIVITÉ
// =============================================

model SharedProfileActivity {
  id           String                @id @default(uuid())
  profile      SharedAccountUser     @relation(fields: [profileId], references: [id])
  profileId    String
  action       ProfileActivityAction
  details      Json?
  performed_at DateTime              @default(now())
}

enum ProfileActivityAction {
  LOGIN
  CONTENT_ACCESS
  SETTINGS_CHANGE
}
