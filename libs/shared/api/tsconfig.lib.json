{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/shared/api",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/shared/api/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true
  },
  "include": [
    "src/index.ts",
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../domains/errors/tsconfig.lib.json"
    }
  ]
}
