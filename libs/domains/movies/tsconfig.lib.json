{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/domains/movies",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/domains/movies/tsconfig.lib.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true
  },
  "include": [
    "src/index.ts",
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../shared/database/tsconfig.lib.json"
    },
    {
      "path": "../video/tsconfig.lib.json"
    },
    {
      "path": "../common/tsconfig.lib.json"
    },
    {
      "path": "../contents/tsconfig.lib.json"
    },
    {
      "path": "../../shared/cqrs/tsconfig.lib.json"
    },
    {
      "path": "../../shared/bullmq/tsconfig.lib.json"
    }
  ]
}
