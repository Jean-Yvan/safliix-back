{
  "name": "@safliix-back/common",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "nx": {
    "root": "libs/domains/common",
    "sourceRoot": "libs/domains/common/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "outputPath": "dist/libs/domains/common",
          "main": "libs/domains/common/src/index.ts",
          "tsConfig": "libs/domains/common/tsconfig.lib.json",
          "assets": [
            "libs/domains/common/src/**/*"
          ]
        }
      }
    }
  }
}
