{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": [
    "src/**/*.ts",
    "profile/**/*.ts",
    "purchase/**/*.ts",
    "subscription/**/*.ts",
    "viewTracking/**/*.ts",
    "auth/**/*.ts",
    "catalog/**/*.ts",
    "content/**/*.ts",
    "interactions/**/*.ts",
    "checkout/**/*.ts",
    "user/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/domains/videoTracking/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domains/access/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domains/users/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domains/profile/tsconfig.lib.json"
    }
  ]
}
